config APP_MEMFAULT_MODULE
	bool "Memfault module group"
	select MEMFAULT
	help
	  Memfault core, metrics, OTA triggers, and optional nRF70 CDR.

if APP_MEMFAULT_MODULE

module = APP_MEMFAULT_MODULE
module-str = app_memfault_module
source "subsys/logging/Kconfig.template.log_config"

config NRF70_FW_STATS_CDR_ENABLED
	bool "Enable nRF70 firmware statistics CDR upload to Memfault"
	depends on MEMFAULT_CDR_ENABLE
	depends on WIFI_NRF700X
	help
	  Collect and upload nRF70 WiFi firmware statistics (PHY, LMAC, UMAC)
	  as Custom Data Recording. Trigger: Button 1 short press, or every
	  Memfault metrics heartbeat (same cadence as metrics/log collection --
	  see memfault_metrics_heartbeat_collect_data() in memfault_core.c).
	  CDR uploads are limited to 1 per device per 24 hours.

config MEMFAULT_UPLOAD_THREAD_STACK_SIZE
	int "Stack size for the Memfault on-connect upload thread (bytes)"
	help
	  Stack size for the thread that performs an immediate Memfault data
	  upload on WiFi connect.  The thread calls getaddrinfo() (DNS) and
	  memfault_zephyr_port_post_data() (TLS + HTTPS), both of which need
	  several kilobytes of stack.  6144 bytes is the recommended minimum
	  for the nRF7002DK.  Override in prj.conf if needed.

config MEMFAULT_OTA_CHECK_INTERVAL_MIN
	int "Periodic OTA check interval in minutes"
	range 1 1440
	help
	  How often the OTA trigger thread checks Memfault cloud for a new
	  firmware release when no manual trigger (button or connect event)
	  has fired.  Default is 60 minutes.

config MEMFAULT_OTA_CONNECT_DELAY_SEC
	int "Delay before OTA check after network connect or button press (seconds)"
	range 0 300
	help
	  After a network-connect or button-press event signals the OTA thread,
	  the thread sleeps this many seconds before calling memfault_fota_start().
	  This gives the DNS resolver time to settle after a fresh connection.
	  Default is 60 seconds.

config MEMFAULT_OTA_THREAD_STACK_SIZE
	int "Stack size for the Memfault OTA trigger thread (bytes)"
	help
	  Stack size for the thread that calls memfault_fota_start().
	  4096 bytes is sufficient as the Memfault NCS port spawns its own
	  HTTPS transfer internally.  Override in prj.conf if needed.

config APP_MEMFAULT_HEARTBEAT_FORCE_INTERVAL_SEC
	int "Force an immediate Memfault heartbeat + log collection + upload every N seconds while connected (0 = disabled)"
	range 0 3600
	help
	  The Memfault SDK version bundled with NCS v2.6.4 has a fixed 3600 s
	  metrics heartbeat interval (no MEMFAULT_METRICS_HEARTBEAT_INTERVAL_SECS
	  Kconfig to shorten it), and log entries are never uploaded at all
	  unless memfault_log_trigger_collection() is called (normally only
	  done after a disconnect/reconnect restore). For active testing/
	  debugging where you want metrics AND logs to show up on the Memfault
	  dashboard faster than once an hour / without a disconnect, set this to
	  periodically call memfault_metrics_heartbeat_debug_trigger() +
	  memfault_log_trigger_collection() and post the result while WiFi is
	  connected. Leave at 0 (default) for production builds: forcing
	  frequent uploads increases Memfault ingestion volume and HTTPS/radio
	  activity.

config APP_MEMFAULT_LOG_STATE_RESTORE
	bool "Persist disconnect-time Memfault log entries; restore and upload on next WiFi connect"
	depends on FLASH_MAP
	help
	  On connectivity loss, drains unread entries from the live Memfault log
	  ring buffer (via memfault_log_read()) and serializes them to a
	  dedicated partition on the external SPI/QSPI NOR flash
	  ("mflt_log_state_partition", MX25R64).  On the next WiFi reconnect,
	  the entries are replayed back into the ring buffer (via
	  memfault_log_save_preformatted()) before upload, and
	  memfault_log_trigger_collection() marks them for upload.  The
	  partition is erased after the restore.
	  Note: the Memfault SDK version bundled with NCS v2.6.4 has no raw
	  ring-buffer save/restore API (memfault_log_get_state() /
	  memfault_log_restore_state()), so this drain-and-replay approach is
	  used instead of a raw memory copy. Replayed entries carry the
	  restore-time timestamp, not the original disconnect-time timestamp.

config APP_MEMFAULT_CDR_STATE_RESTORE
	bool "Persist disconnect-time nRF70 CDR (WiFi stats) to flash; restore and upload on reconnect"
	depends on FLASH_MAP
	depends on NRF70_FW_STATS_CDR_ENABLED
	help
	  When the log-persist work fires 10 s after connectivity loss, collects
	  fresh nRF70 firmware statistics (PHY/LMAC/UMAC) and writes the raw CDR
	  blob to a dedicated partition on the external SPI/QSPI NOR flash
	  ("mflt_cdr_state_partition", MX25R64).  On the next WiFi reconnect the
	  blob is restored into the CDR source buffer and uploaded to Memfault
	  cloud.  The partition is erased after restore.

endif # APP_MEMFAULT_MODULE
