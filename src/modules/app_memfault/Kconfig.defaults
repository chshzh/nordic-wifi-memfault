#
# Default values for app_memfault module symbols.
# Override in prj.conf as needed.
# Note: choice symbols (log levels) cannot be set here; use prj.conf.
#

config APP_MEMFAULT_MODULE
	default n

config NRF70_FW_STATS_CDR_ENABLED
	default n

# HWM 2596 B (TLS upload) × 1.5 = 3894 → 4096
config MEMFAULT_UPLOAD_THREAD_STACK_SIZE
	default 4096

config MEMFAULT_OTA_CHECK_INTERVAL_MIN
	default 60 if APP_MEMFAULT_MODULE

config MEMFAULT_OTA_CONNECT_DELAY_SEC
	default 30 if APP_MEMFAULT_MODULE

config MEMFAULT_OTA_THREAD_STACK_SIZE
	default 4096 if APP_MEMFAULT_MODULE

config APP_MEMFAULT_HEARTBEAT_FORCE_INTERVAL_SEC
	default 0 if APP_MEMFAULT_MODULE

# ---------------------------------------------------------------------------
# Memfault SDK logging
# ---------------------------------------------------------------------------
config MEMFAULT_LOGGING_ENABLE
	default y if APP_MEMFAULT_MODULE

config MEMFAULT_LOGGING_RAM_SIZE
	default 8192 if APP_MEMFAULT_MODULE

config MEMFAULT_SHELL
	default n

config APP_MEMFAULT_LOG_STATE_RESTORE
	default y if APP_MEMFAULT_MODULE

config APP_MEMFAULT_CDR_STATE_RESTORE
	default y if APP_MEMFAULT_MODULE && NRF70_FW_STATS_CDR_ENABLED

config MEMFAULT_FOTA_CLI_CMD
	default n

# ---------------------------------------------------------------------------
# Memfault HTTP upload
# ---------------------------------------------------------------------------
config MEMFAULT_HTTP_ENABLE
	default y if APP_MEMFAULT_MODULE

config MEMFAULT_HTTP_PERIODIC_UPLOAD
	default y if APP_MEMFAULT_MODULE

# MEMFAULT_HTTP_PERIODIC_UPLOAD_LOGS does not exist in the Memfault SDK
# version bundled with NCS v2.6.4; periodic upload covers core Memfault data
# only on this version.

config MEMFAULT_HTTP_PERIODIC_UPLOAD_INTERVAL_SECS
	default 60 if APP_MEMFAULT_MODULE

# ---------------------------------------------------------------------------
# Coredump
# ---------------------------------------------------------------------------
# Left off deliberately. Full thread stacks do NOT fit here: the 21 threads
# total ~92 KiB of stack (BT RX alone is 22000 B and is a hard requirement --
# see wifi_prov_over_ble/Kconfig.defaults), while the memfault_storage
# partition is 64 KiB. Enabling it truncates the coredump partway through the
# stacks and drops the trailing regions, including the 5160 B .data region.
#
# It is also not needed for stack watermarks: MEMFAULT_COREDUMP_COMPUTE_THREAD_
# STACK_USAGE (default y) records per-thread unused bytes in a 128 B array that
# always fits. That mechanism was silently defeated by CONFIG_STACK_SENTINEL --
# now disabled in prj.conf, see the comment there and Memfault issue 1805279755.
config MEMFAULT_COREDUMP_FULL_THREAD_STACKS
	default n

config MEMFAULT_COREDUMP_COLLECT_BSS_REGIONS
	default n

config MEMFAULT_NCS_INTERNAL_FLASH_BACKED_COREDUMP
	default y if APP_MEMFAULT_MODULE

# ---------------------------------------------------------------------------
# Firmware type (Memfault Software Type) — set per board target
# ---------------------------------------------------------------------------
# NCS default is "app". Override here so the Memfault fleet can distinguish
# devices by hardware without requiring board conf files.
config MEMFAULT_NCS_FW_TYPE
	default "nrf7002dk-fw"   if BOARD_NRF7002DK_NRF5340_CPUAPP

# ---------------------------------------------------------------------------
# Hardware version (Memfault Hardware Version) — set per board target
# ---------------------------------------------------------------------------
# NCS default is the raw Zephyr BOARD name (e.g. "nrf7002dk_nrf5340_cpuapp"),
# which never matches the "nrf7002dk" hardware_version already used by every
# release/deployment in the Memfault project for this board. Left at the
# BOARD default, OTA's "latest release" check returns 204/non_primary_sw_type
# for every check — the release exists but never resolves for this device's
# hardware_version.
config MEMFAULT_NCS_HW_VERSION
	default "nrf7002dk"   if BOARD_NRF7002DK_NRF5340_CPUAPP

# ---------------------------------------------------------------------------
# Firmware version
# ---------------------------------------------------------------------------
# MEMFAULT_NCS_FW_VERSION_STATIC is a choice symbol - set in prj.conf.
# MEMFAULT_NCS_FW_VERSION is project-specific - set in prj.conf.

# ---------------------------------------------------------------------------
# Metrics
# ---------------------------------------------------------------------------
config MEMFAULT_METRICS
	default y if APP_MEMFAULT_MODULE

# MEMFAULT_METRICS_HEARTBEAT_INTERVAL_SECS does not exist in the Memfault SDK
# version bundled with NCS v2.6.4 (heartbeat interval is fixed on this SDK).

config MEMFAULT_NCS_IMPLEMENT_METRICS_COLLECTION
	default n

config MEMFAULT_NCS_BT_METRICS
	default n

config MEMFAULT_NCS_LTE_METRICS
	default n

config MEMFAULT_NCS_STACK_METRICS
	default y if APP_MEMFAULT_MODULE

# MEMFAULT_METRICS_CPU_TEMP, MEMFAULT_METRICS_WIFI,
# MEMFAULT_METRICS_CONNECTIVITY_CONNECTED_TIME, MEMFAULT_METRICS_BLUETOOTH,
# MEMFAULT_METRICS_THREADS_DEFAULTS, MEMFAULT_METRICS_BOOT_TIME,
# MEMFAULT_METRICS_TCP_IP, MEMFAULT_METRICS_MEMORY_USAGE, and
# MEMFAULT_METRICS_THREADS are auto-collected metrics added to the Memfault
# NCS integration after the SDK version bundled with NCS v2.6.4; no
# equivalent exists here (app code does not reference these symbols).

config MEMFAULT_METRICS_DEFAULT_SET_ENABLE
	default y if APP_MEMFAULT_MODULE

# MEMFAULT_METRICS_SYNC_SUCCESS / MEMFAULT_METRICS_MEMFAULT_SYNC_SUCCESS map to
# the SDK's own MEMFAULT_SYNC_MEMFAULT_METRICS on NCS v2.6.4, already on by
# default.

config MEMFAULT_HEAP_STATS
	default y if APP_MEMFAULT_MODULE

config SYS_HEAP_RUNTIME_STATS
	default y if APP_MEMFAULT_MODULE

# ---------------------------------------------------------------------------
# CDR (Custom Data Recording)
# ---------------------------------------------------------------------------
config MEMFAULT_CDR_ENABLE
	default y if APP_MEMFAULT_MODULE

# NRF70_FW_STATS_CDR_ENABLED default n - override to y in prj.conf to enable.
# WARNING: CDR uploads are limited to 1 per device per 24 hours.

# ---------------------------------------------------------------------------
# Certificate management
# ---------------------------------------------------------------------------
# MEMFAULT_ROOT_CERT_STORAGE_TLS_CREDENTIAL_STORAGE is a choice symbol - set in prj.conf.

config MEMFAULT_NCS_PROVISION_CERTIFICATES
	default y if APP_MEMFAULT_MODULE

# ---------------------------------------------------------------------------
# FOTA (Firmware Over-The-Air update)
# ---------------------------------------------------------------------------
config MEMFAULT_FOTA
	default y if APP_MEMFAULT_MODULE

config DFU_TARGET
	default y if APP_MEMFAULT_MODULE

config DFU_TARGET_MCUBOOT
	default y if APP_MEMFAULT_MODULE

config IMG_MANAGER
	default y if APP_MEMFAULT_MODULE

config STREAM_FLASH
	default y if APP_MEMFAULT_MODULE

config IMG_ERASE_PROGRESSIVELY
	default y if APP_MEMFAULT_MODULE

config FOTA_DOWNLOAD
	default y if APP_MEMFAULT_MODULE

config FOTA_DOWNLOAD_PROGRESS_EVT
	default y if APP_MEMFAULT_MODULE

config DOWNLOAD_CLIENT
	default y if APP_MEMFAULT_MODULE

config DOWNLOAD_CLIENT_MAX_FILENAME_SIZE
	default 400 if APP_MEMFAULT_MODULE

config DOWNLOAD_CLIENT_STACK_SIZE
	default 4096 if APP_MEMFAULT_MODULE

# ---------------------------------------------------------------------------
# Misc optimizations required by app_memfault
# ---------------------------------------------------------------------------
# POSIX_FILE_SYSTEM does not exist on NCS v2.6.4; no equivalent needed here.
