#
# Default values for the network / WiFi infrastructure module.
# Override in prj.conf as needed.
# Note: choice symbols (log levels) cannot be set here; use prj.conf.
#

# ---------------------------------------------------------------------------
# WiFi driver (nRF70)
# ---------------------------------------------------------------------------
config WIFI
	default y if WIFI_MODULE

# NCS v2.6.4 names the nRF70 driver menuconfig WIFI_NRF700X (renamed to
# WIFI_NRF70 in a later NCS release).
config WIFI_NRF700X
	default y if WIFI_MODULE

# ---------------------------------------------------------------------------
# WPA supplicant
# ---------------------------------------------------------------------------
# NCS v2.6.4 drives the nRF70 driver through the nRF wrapper WPA_SUPP
# (nrf/modules/hostap), not Zephyr's WIFI_NM_WPA_SUPPLICANT.
config WPA_SUPP
	default y if WIFI_MODULE

config WPA_SUPP_THREAD_STACK_SIZE
	default 8192 if WIFI_MODULE

config WPA_SUPP_WQ_STACK_SIZE
	default 5632 if WIFI_MODULE

# ---------------------------------------------------------------------------
# nRF70 driver settings
# ---------------------------------------------------------------------------
config NRF_WIFI_SCAN_MAX_BSS_CNT
	default 20 if WIFI_MODULE

# NRF_WIFI_CTRL_HEAP_SIZE / NRF_WIFI_DATA_HEAP_SIZE (split heap) do not exist
# on the nRF70 driver bundled with NCS v2.6.4; it uses HEAP_MEM_POOL_SIZE.

config NRF700X_RX_NUM_BUFS
	default 16 if WIFI_MODULE

config NRF700X_MAX_TX_AGGREGATION
	default 4 if WIFI_MODULE

# ---------------------------------------------------------------------------
# WiFi / BLE coexistence
# ---------------------------------------------------------------------------
config NRF700X_SR_COEX
	default y if WIFI_MODULE

# NRF70_SR_COEX_RF_SWITCH has no equivalent on NCS v2.6.4: RF-switch based
# coex (NRF700X_RADIO_COEX) is derived automatically from the nrf_radio_coex
# devicetree node, not a user Kconfig option.

# ---------------------------------------------------------------------------
# L2 WiFi connectivity (connection manager)
# ---------------------------------------------------------------------------
config NET_CONNECTION_MANAGER
	default y if WIFI_MODULE

# HWM 4572 B (88% of 5168!) × 1.5 = 6858 → 7168 — INCREASED for safety
config NET_CONNECTION_MANAGER_MONITOR_STACK_SIZE
	default 7168 if WIFI_MODULE

# L2_WIFI_CONNECTIVITY is disabled on NCS v2.6.4: combined with this app's
# other options it triggers a devicetree-ordinal macro-expansion bug in
# Zephyr's CONN_MGR_BIND_CONN_INST()/NET_IF_GET() (net_if.h), producing a
# malformed __net_if_<ordinal> token (verified independent of this app: the
# same combination does NOT fail on the plain nrf700x STA sample, so this is
# specific to this app's larger Kconfig graph on this NCS version). The app's
# own network/net_event_mgmt.c already implements manual connect/reconnect
# and readiness tracking, making this subsystem redundant here anyway.
config L2_WIFI_CONNECTIVITY
	default n

config L2_WIFI_CONNECTIVITY_AUTO_CONNECT
	default n

config L2_WIFI_CONNECTIVITY_AUTO_DOWN
	default n

# ---------------------------------------------------------------------------
# WiFi credentials (persistent storage via ZMS)
# ---------------------------------------------------------------------------
config WIFI_CREDENTIALS
	default y if WIFI_MODULE

# WIFI_CREDENTIALS_BACKEND_SETTINGS is a choice symbol - set in prj.conf.

# ---------------------------------------------------------------------------
# Network stack
# ---------------------------------------------------------------------------
config NETWORKING
	default y if WIFI_MODULE

config NET_IPV4
	default y if WIFI_MODULE

config NET_IPV6
	default n

config NET_UDP
	default y if WIFI_MODULE

config NET_TCP
	default y if WIFI_MODULE

config NET_TCP_TIME_WAIT_DELAY
	default 1000 if WIFI_MODULE

config NET_DHCPV4
	default y if WIFI_MODULE

# ---------------------------------------------------------------------------
# Network buffers
# ---------------------------------------------------------------------------
config NET_PKT_RX_COUNT
	default 8 if WIFI_MODULE

config NET_PKT_TX_COUNT
	default 8 if WIFI_MODULE

config NET_BUF_RX_COUNT
	default 16 if WIFI_MODULE

config NET_BUF_TX_COUNT
	default 64 if WIFI_MODULE

# NET_BUF_FIXED_DATA_SIZE is a choice symbol - set in prj.conf.

config NET_BUF_DATA_SIZE
	default 128 if WIFI_MODULE

config NET_TC_TX_COUNT
	default 1 if WIFI_MODULE

# ---------------------------------------------------------------------------
# Network interface
# ---------------------------------------------------------------------------
config NET_IF_UNICAST_IPV4_ADDR_COUNT
	default 1 if WIFI_MODULE

config NET_MAX_CONTEXTS
	default 10 if WIFI_MODULE

config NET_MAX_CONN
	default 10 if WIFI_MODULE

# ---------------------------------------------------------------------------
# Sockets
# ---------------------------------------------------------------------------
config NET_SOCKETS
	default y if WIFI_MODULE

config NET_SOCKETS_POLL_MAX
	default 20 if WIFI_MODULE

# ---------------------------------------------------------------------------
# DNS resolution
# Allow concurrent lookups from app_https_client, app_mqtt_client, app_memfault.
# ---------------------------------------------------------------------------
config DNS_RESOLVER
	default y if WIFI_MODULE

config DNS_RESOLVER_ADDITIONAL_BUF_CTR
	default 2 if WIFI_MODULE

config DNS_RESOLVER_ADDITIONAL_QUERIES
	default 2 if WIFI_MODULE

# ---------------------------------------------------------------------------
# Net management event queue
# ---------------------------------------------------------------------------
config NET_MGMT_EVENT_QUEUE_SIZE
	default 150 if WIFI_MODULE

# HWM 2580 B (22% of 12000) × 2.0 = 5160 → 6144 — halved with 2× safety margin
config NET_MGMT_EVENT_STACK_SIZE
	default 6144 if WIFI_MODULE

config NET_MGMT_EVENT_QUEUE_TIMEOUT
	default 5000 if WIFI_MODULE
